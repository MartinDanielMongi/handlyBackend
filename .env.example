# Local development only. In Railway, configure these in the Variables panel.
PORT=3001
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Password recovery with Resend.
RESEND_API_KEY=re_your_api_key
RESET_EMAIL_FROM=Handys <no-reply@handys.com.ar>
BUG_REPORT_NOTIFICATION_EMAIL=your-email@example.com
SPECIALTY_REQUEST_NOTIFICATION_EMAIL=your-email@example.com

# Google OAuth: create a "Web application" client in Google Cloud.
# The redirect URI must point to the backend and match Google Cloud exactly.
# Local:      http://localhost:3001/api/auth/google/callback
# Production: https://YOUR-BACKEND.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
